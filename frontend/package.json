    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^1.6.0",
    "jsdom": "^24.1.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.4.8",
    "jest-axe": "^8.0.0",
